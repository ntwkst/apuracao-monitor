{
  "name": "apuracao-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitor de apuração eleitoral BR (TSE) com gráfico minuto a minuto e projeção por abertura das linhas",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "poller": "tsx src/poller/run.ts",
    "poller:once": "tsx src/poller/run.ts --once",
    "sim": "tsx scripts/simulate-night.ts",
    "sim:t2": "tsx scripts/simulate-t2-from-polls.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build": "npm run typecheck && npm run web:build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
